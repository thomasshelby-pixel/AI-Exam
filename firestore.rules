rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Firestore is a server-owned persistence layer for this application.
    // Backend reads/writes run through the Firebase Admin SDK and Google Cloud IAM.
    // No unauthenticated or browser-client reads/writes are permitted.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
