rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'SUPER_ADMIN' ||
         request.auth.token.email in ['admin@caexamchecker.ai', 'superadmin@ca-exam-checker.com']);
    }

    // Default deny for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Account Suspensions & Administrative Enforcement Records
    match /account_suspensions/{suspensionId} {
      allow read: if true;
      allow write: if true;
    }

    // Student Profiles
    match /student_profiles/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Student Examiner Profiles
    match /student_examiner_profiles/{profileId} {
      allow read: if true;
      allow write: if true;
    }

    // Student Disclaimers & Mandatory Acknowledgments
    match /student_disclaimers/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    match /student_disclaimer_acknowledgements/{ackId} {
      allow read: if true;
      allow write: if true;
    }

    // Institutes & Batches
    match /institutes/{instituteId} {
      allow read: if true;
      allow write: if true;
    }

    match /batches/{batchId} {
      allow read: if true;
      allow write: if true;
    }

    match /institute_memberships/{membershipId} {
      allow read: if true;
      allow write: if true;
    }

    // ICAI Reference Materials & Marking Schemes
    match /evaluation_materials/{materialId} {
      allow read: if true;
      allow write: if true;
    }

    // Institute Proprietary Materials
    match /institute_materials/{materialId} {
      allow read: if true;
      allow write: if true;
    }

    // Evaluations
    match /evaluations/{evaluationId} {
      allow read: if true;
      allow write: if true;
    }

    // Evaluation Versions (Immutable V1/V2 audit & recheck records)
    match /evaluation_versions/{versionId} {
      allow read: if true;
      allow write: if true;
    }

    // Credit Ledger (Append-only immutable audit trail)
    match /credit_ledger/{ledgerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Payment Orders & Transactions
    match /payment_orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    match /payment_transactions/{transactionId} {
      allow read: if true;
      allow write: if true;
    }

    // System Audit Logs (Append-only immutable audit trail)
    match /audit_logs/{logId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Permanent Deletion Tombstones
    match /tombstones/{tombstoneId} {
      allow read: if true;
      allow write: if true;
    }

    // Persistent Cloud File Metadata & References (Binary is stored in Firebase Cloud Storage)
    match /file_storage_metadata/{fileId} {
      allow read: if true;
      allow write: if true;
    }

    // Official Legal Documents & Versioning (Terms, Privacy, Refund)
    match /legal_documents/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Legal Document Acceptance & Audit Trail
    match /legal_acknowledgements/{ackId} {
      allow read: if true;
      allow write: if true;
    }

    // Legal Settings & Business Entity Configuration
    match /legal_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Recheck & Verification Requests
    match /recheck_requests/{requestId} {
      allow read: if true;
      allow write: if true;
    }

    // Student Credit Purchases & Entitlements
    match /student_credit_purchases/{purchaseId} {
      allow read: if true;
      allow write: if true;
    }

    // Support Tickets
    match /support_tickets/{ticketId} {
      allow read: if true;
      allow write: if true;
    }

    // Institute Tests, Attempts & Plans
    match /institute_tests/{testId} {
      allow read: if true;
      allow write: if true;
    }

    match /exam_attempts/{attemptId} {
      allow read: if true;
      allow write: if true;
    }

    match /institute_plans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    // Permanent Free Entitlements
    match /permanent_free_entitlements/{entitlementId} {
      allow read: if true;
      allow write: if true;
    }

    // Referral Campaigns & Redemptions
    match /referral_campaigns/{campaignId} {
      allow read: if true;
      allow write: if true;
    }

    match /referral_redemptions/{redemptionId} {
      allow read: if true;
      allow write: if true;
    }

    // Pricing & System Settings (AI Model Configuration, Fallback Chain, etc.)
    match /pricing_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // System Configuration (AI Model Routing & System-wide settings)
    match /system_configuration/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Student Reviews & Feedback
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    // MFA Authenticators, Recovery Codes, and Trusted Devices
    match /mfa_authenticators/{authId} {
      allow read: if true;
      allow write: if true;
    }

    match /mfa_recovery_codes/{codeId} {
      allow read: if true;
      allow write: if true;
    }

    match /trusted_devices/{deviceId} {
      allow read: if true;
      allow write: if true;
    }

    // MCQ Materials & Questions (Source documents and question pool)
    match /mcq_materials/{materialId} {
      allow read: if true;
      allow write: if true;
    }

    match /mcq_questions/{questionId} {
      allow read: if true;
      allow write: if true;
    }

    match /mcq_sessions/{sessionId} {
      allow read: if true;
      allow write: if true;
    }

    match /mcq_user_responses/{responseId} {
      allow read: if true;
      allow write: if true;
    }

    match /mcq_bookmarks/{bookmarkId} {
      allow read: if true;
      allow write: if true;
    }

    match /mcq_wrong_vault/{vaultId} {
      allow read: if true;
      allow write: if true;
    }

    match /mcq_scoring_rules/{ruleId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Notification Centre & Broadcast Campaigns
    match /broadcast_campaigns/{campaignId} {
      allow read: if true;
      allow write: if true;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    match /notification_delivery_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    match /user_notification_preferences/{prefId} {
      allow read: if true;
      allow write: if true;
    }

    // Free Trial Abuse Prevention Signals (Hashed identifiers only)
    match /free_trial_abuse_signals/{signalId} {
      allow read: if true;
      allow write: if true;
    }

    // Student Institute Enrollments
    match /enrollments/{enrollmentId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
