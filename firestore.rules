rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All application data is accessed through the authenticated Express backend.
    // The backend uses the privileged Firebase Admin SDK, which bypasses these
    // client security rules. Firebase Web SDK / REST clients must not read or
    // mutate user, student, institute, evaluation, payment, MFA, or system data.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
